ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS + pgvector
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grievance_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grievance_db

# Redis (Workers, Outbox, Caching, Idempotency)
REDIS_URL=redis://localhost:6379/0

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=complaints-attachments
MINIO_SECURE=false

# Authentication & Security
JWT_SECRET_KEY=change_this_super_secret_key_in_production_min_32_bytes_3892718923
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
