ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS + pgvector
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grievance_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grievance_db

# Redis (Workers, Outbox, Caching, Idempotency)
REDIS_URL=redis://localhost:6379/0

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=complaints-attachments
MINIO_SECURE=false
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# Authentication & Security
JWT_SECRET_KEY=change_this_super_secret_key_in_production_min_32_bytes_3892718923
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider (MockProvider is used when GEMINI_API_KEY is empty)
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_CONFIDENCE_THRESHOLD=0.7
AI_TIMEOUT_SECONDS=10

# Browser clients allowed to call the API. Set the deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_SIZE_MB=15
