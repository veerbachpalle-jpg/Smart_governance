# ==============================================================================
# CivicSense Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# Local Development: http://localhost:8000/api/v1
# Production with Nginx/Reverse Proxy: /api/v1
# Production with Separate Domains: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Use Client-side Mocks by default (set to 'false' in live production)
# When 'false' or when Original mode is selected, the portal calls the live backend API
VITE_USE_MOCKS=false
